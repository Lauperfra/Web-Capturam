# Backend PHP del formulario de contacto: las librerías de terceros
# (PHPMailer, vía composer install) no se versionan, igual que venv/.
# enviar-contacto.php y .htaccess sí se versionan: no contienen secretos,
# las credenciales solo viven en capturam-mail-config.php (fuera del repo).
server/vendor/
dist/vendor/
capturam-mail-config.php

# Panel de administración de publicaciones: capturam-admin-config.php (fuera
# del repo, igual que capturam-mail-config.php) y las publicaciones/PDFs que
# suba el CEO desde el panel, que solo deben vivir en el servidor real.
capturam-admin-config.php
dist/publicaciones-datos/
