# Endurecimiento básico para el endpoint PHP del formulario de contacto.
# Este archivo se copia a la raíz de dist/ (junto a enviar-contacto.php).

# Página de error propia (misma imagen que el resto de la web) en vez de la
# página fea por defecto del servidor, tanto si la URL no existe (404) como
# si el acceso está bloqueado por las reglas de abajo (403).
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Límite de subida para el panel de publicaciones (PDF/imagen, hasta 15MB
# reales en la app): en hostings con PHP como módulo de Apache (mod_php),
# esto sube el límite del propio servidor sin que haya que tocar nada desde
# el panel de control. En hostings con PHP-FPM/CGI (lo más habitual hoy),
# quien hace ese mismo trabajo es .user.ini (ver ese archivo) — el
# <IfModule> de aquí abajo simplemente no hace nada en ese caso, así que no
# hay riesgo de romper nada por tener ambos a la vez.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>

# No servir nunca los archivos de Composer ni la plantilla de configuración
# de ejemplo (ninguno de los dos contiene secretos reales, pero no deben
# ser accesibles por HTTP).
<FilesMatch "\.(json|lock|md)$">
    Require all denied
</FilesMatch>

# El archivo de configuración real vive FUERA de este directorio (un nivel
# por encima de public_html) y por tanto nunca es accesible por HTTP. Esta
# regla es un cinturón de seguridad adicional por si alguna vez apareciera
# aquí por error.
<FilesMatch "^capturam-mail-config\.php$">
    Require all denied
</FilesMatch>

# Bloquea el acceso directo a las librerías de PHPMailer: solo deben
# cargarse mediante "require" desde enviar-contacto.php, nunca pedirse
# directamente por URL. También sirve las URLs "limpias" (sin ".html")
# usadas en todos los enlaces internos.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^vendor/ - [F,L]

    # Caso especial: index.html es la home, cuya URL limpia es "/" (no
    # "/index") — sin esto, la regla genérica de abajo redirigiría
    # index.html a /index, que no existe.
    RewriteRule ^index\.html$ / [R=301,L]

    # Si alguien pide la URL con ".html" (enlace o marcador viejo), redirige
    # de verdad a la versión limpia — evita contenido duplicado y que se
    # vea el .html.
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Igual si la piden con una barra final (enlace, marcador o autocompletado
    # viejo de antes de tener URLs limpias) — redirige a la versión sin barra.
    RewriteRule ^(empresa|servicios|sectores|proyectos|como-trabajamos|publicaciones|legal|privacidad|contacto)/$ /$1 [R=301,L]

    # Sirve por dentro el archivo .html real cuando piden la URL limpia, sin
    # que cambie lo que se ve en la barra de direcciones. Una regla
    # explícita por página (no una genérica basada en comprobar si el
    # archivo existe: esa comprobación no se comportaba igual en todos los
    # hostings).
    RewriteRule ^empresa$ empresa.html [L]
    RewriteRule ^servicios$ servicios.html [L]
    RewriteRule ^sectores$ sectores.html [L]
    RewriteRule ^proyectos$ proyectos.html [L]
    RewriteRule ^como-trabajamos$ como-trabajamos.html [L]
    RewriteRule ^publicaciones$ publicaciones.html [L]
    RewriteRule ^legal$ legal.html [L]
    RewriteRule ^privacidad$ privacidad.html [L]
    RewriteRule ^contacto$ contacto.html [L]
</IfModule>
