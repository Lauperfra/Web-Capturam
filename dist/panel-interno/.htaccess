# Endurecimiento del panel de administración. Se copia a dist/panel-interno/.

Options -Indexes

# Ningún archivo que empiece por "_" debe pedirse nunca directamente por URL
# (_bootstrap.php, _contenido.php, _cli_regenerar_contenido.php...): solo se
# incluyen desde los scripts públicos del panel, o se ejecutan por línea de
# comandos.
<FilesMatch "^_">
    Require all denied
</FilesMatch>

# El resto de estos tipos tampoco deben ser accesibles aquí (ya se bloquean
# a nivel de dist/.htaccess, esto es un cinturón de seguridad adicional).
<FilesMatch "\.(json|md|example\.php)$">
    Require all denied
</FilesMatch>

# URLs limpias (sin ".php") para login/panel/logout, igual que en el resto
# de la web.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si alguien pide el archivo .php directamente, redirige a la URL limpia.
    RewriteCond %{THE_REQUEST} \s/+panel-interno/(login|panel|logout|contenido)\.php[\s?] [NC]
    RewriteRule ^ /panel-interno/%1 [R=301,L]

    # Sirve por dentro el archivo .php real cuando piden la URL limpia (la
    # cadena de consulta, p. ej. "?editar=ID" o "?pagina=empresa", se
    # conserva automáticamente).
    RewriteRule ^login$ login.php [L]
    RewriteRule ^panel$ panel.php [L]
    RewriteRule ^logout$ logout.php [L]
    RewriteRule ^contenido$ contenido.php [L]
</IfModule>
